# Dance — per-user configuration.
#
# Copy this file to ~/.dance/.env and fill in what you want. Every key
# is optional unless the comment says otherwise. Settings load via
# DANCE_ env prefix; values here override the in-code defaults.

# ---------------------------------------------------------------------------
# Spotify — required for "Add from Spotify" search in Cmd-K
# ---------------------------------------------------------------------------
# Register an app at https://developer.spotify.com/dashboard (5 min, free).
# Client ID is shown plain; click "View client secret" to reveal.
# DANCE_SPOTIFY_CLIENT_ID=
# DANCE_SPOTIFY_CLIENT_SECRET=

# Optional: paste a Spotify playlist URL for `dance sync` batch ingest.
# DANCE_SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/...

# ---------------------------------------------------------------------------
# YouTube cookies — strongly recommended for reliable yt-dlp downloads
# ---------------------------------------------------------------------------
# Without cookies, YouTube will throttle / 403 / show "Sign in to confirm
# you're not a bot." Export via the "Get cookies.txt LOCALLY" Chrome
# extension and save the file. Default looks in ~/.dance/cookies.txt — set
# only if you want it elsewhere.
# DANCE_YOUTUBE_COOKIES_FILE=

# ---------------------------------------------------------------------------
# Directories — leave blank to use the defaults in your home
# ---------------------------------------------------------------------------
# DANCE_LIBRARY_DIR=~/Music/DJ/library
# DANCE_STEMS_DIR=~/Music/DJ/stems
# DANCE_DATA_DIR=~/.dance
# DANCE_ALS_OUTPUT_DIR=~/Music/Dance/Sets

# ---------------------------------------------------------------------------
# Pipeline toggles
# ---------------------------------------------------------------------------
# Skip the slow stages when you're just testing the FE on a fresh machine:
# DANCE_SKIP_STEMS=true
# DANCE_SKIP_EMBEDDINGS=true

# Audio output format / quality (default mp3 / 320k):
# DANCE_AUDIO_FORMAT=mp3
# DANCE_AUDIO_QUALITY=320k

# ---------------------------------------------------------------------------
# Models — defaults are sensible; only change if you have a specific reason
# ---------------------------------------------------------------------------
# DANCE_CLAP_MODEL=laion/clap-htsat-unfused
# DANCE_CLAP_DEVICE=auto   # auto | mps | cuda | cpu
# DANCE_DEMUCS_MODEL=htdemucs_ft
# DANCE_DEMUCS_DEVICE=auto

# ---------------------------------------------------------------------------
# Tagging — local, no API keys
# ---------------------------------------------------------------------------
# DANCE_TAGGER_ENABLED=true
# DANCE_DEEP_TAGGER_ENABLED=false   # Qwen2-Audio, ~8 GB weights, slow
